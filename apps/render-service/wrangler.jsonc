{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "render-service",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "containers": [
    {
      "class_name": "RemotionRendererContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 10,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REMOTION_RENDERER",
        "class_name": "RemotionRendererContainer",
      },
    ],
  },
  "exports": {
    "RemotionRendererContainer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "R2_ACCOUNT_ID": "8f7290274ffb66f85ee1c1179f613064",
    "R2_BUCKET": "faceless",
    "R2_PUBLIC_BASE_URL": "https://pub-66da56cbb16047c7a2f2dc11f412a1a6.r2.dev",
  },
}
