{
  "name": "faceless",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "@types/node": "^26.6.5",
      "varlock": "1.18.0",
      "lucide-react": "^1.61.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@prisma/client": "^7.10.1",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "@trpc/tanstack-react-query": "^11.19.0",
      "@tanstack/react-query": "^5.104.5",
      "better-auth": "1.7.3",
      "@tanstack/react-form": "^1.33.5",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.3",
      "@better-auth/expo": "1.7.3",
      "autumn-js": "^1.5.18",
      "files-sdk": "^3.1.1",
      "@opencoredev/social-sdk": "^0.5.0",
      "eve": "^0.83.2",
      "ai": "^7.0.137"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @faceless/db --",
    "db:studio": "turbo run db:studio -F @faceless/db --",
    "db:generate": "turbo run db:generate -F @faceless/db --",
    "db:migrate": "turbo run db:migrate -F @faceless/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./packages/agent/ && varlock codegen --path ./packages/api/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./packages/agent/ && varlock codegen --path ./packages/api/",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "autumn:setup": "varlock run --path apps/web/ -- bun run ./scripts/setup-autumn.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "autumn-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faceless/config": "workspace:*",
    "@gdp-ts/core": "^0.1.0",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "ultracite": "^8.1.0",
    "varlock": "catalog:",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.4.2"
}
