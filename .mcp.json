{
  "mcpServers": {
    "hackhaton-space-stack": {
      "command": "bunx",
      "args": ["create-hackhaton-space-stack@latest", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "expo-mcp": {
      "type": "http",
      "url": "https://mcp.expo.dev/mcp"
    },
    "autumn": {
      "type": "http",
      "url": "https://mcp.useautumn.com/mcp"
    },
    "fish-audio": {
      "type": "http",
      "url": "https://api.fish.audio/mcp"
    },
    "tester-army": {
      "type": "http",
      "url": "https://tester.army/mcp"
    }
  }
}
