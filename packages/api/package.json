{
  "name": "@faceless/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./services/publisher": {
      "default": "./src/services/publisher/index.ts"
    },
    "./services/renderer": {
      "default": "./src/services/renderer/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.132",
    "@faceless/agent": "workspace:*",
    "@faceless/auth": "workspace:*",
    "@faceless/contracts": "workspace:*",
    "@faceless/db": "workspace:*",
    "@faceless/remotion": "workspace:*",
    "@faceless/socials": "workspace:*",
    "@faceless/storage": "workspace:*",
    "@faceless/utils": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "autumn-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faceless/config": "workspace:*",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  }
}
